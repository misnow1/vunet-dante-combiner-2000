[Unit]
Description=Lock the combiner root filesystem read-only once it has an identity
Documentation=https://github.com/misnow1/vunet-dante-combiner-2000/blob/main/docs/sd-image.md
# Must run AFTER the things that give a clone its own identity and its config.
# Ordering on units that may not exist is a harmless no-op.
After=combiner-hostkeys.service combiner-apply.service
After=cloud-final.service cloud-init.target
# Never race a provisioning run: rebooting mid-provision would be worse than
# leaving the root writable for one more boot.
After=multi-user.target
# Both paths: the script falls back to /boot on images that predate
# /boot/firmware, and a condition naming only the new path would skip the unit
# on exactly those. The "|" prefix makes each a TRIGGERING condition, which
# systemd ORs; without it repeated conditions are ANDed and no unit would ever
# satisfy both.
ConditionPathExists=|/boot/firmware/cmdline.txt
ConditionPathExists=|/boot/cmdline.txt

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/combiner-finalize

[Install]
WantedBy=multi-user.target
